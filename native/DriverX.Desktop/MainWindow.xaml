<Window x:Class="DriverX.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DriverX" Width="1240" Height="780" MinWidth="980" MinHeight="640" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource AppBackground}" FontFamily="{DynamicResource BodyFont}" FontSize="{DynamicResource BodySize}" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True" Foreground="{DynamicResource TextPrimary}" SourceInitialized="WindowSourceInitialized" Closing="WindowClosing">
 <WindowChrome.WindowChrome>
  <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False"/>
 </WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="CaptionButton" TargetType="Button">
   <Setter Property="Width" Value="38"/><Setter Property="Height" Value="32"/>
   <Setter Property="Margin" Value="2,0"/><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" CornerRadius="8" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.6"/></Trigger>
     <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="Close"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Surface" Property="Background" Value="#E5484D"/><Setter Property="Foreground" Value="White"/></MultiTrigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Background="{DynamicResource AppBackground}"><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="242"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Row="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
   <StackPanel Orientation="Horizontal" Margin="26,0" VerticalAlignment="Center"><TextBlock Text="DRIVER" FontSize="{DynamicResource CaptionSize}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text=" X" FontSize="{DynamicResource CaptionSize}" FontWeight="Bold" Foreground="{DynamicResource Accent}"/></StackPanel>
  </Border>
  <Grid Grid.Column="1" Margin="30,0,12,0">
   <TextBlock Text="远程工作空间" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource CaptionSize}"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <Button Style="{StaticResource CaptionButton}" Click="ShowSettings" ToolTip="设置" AutomationProperties.Name="设置"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="{DynamicResource BodySize}"/></Button>
    <Border Width="1" Height="16" Background="{DynamicResource BorderBrush}" Margin="10,0"/>
    <Button Style="{StaticResource CaptionButton}" Click="MinimizeWindow" ToolTip="最小化" AutomationProperties.Name="最小化"><Path Data="M 0,5 L 10,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="10" Height="10"/></Button>
    <Button Click="MaximizeWindow" AutomationProperties.Name="最大化或还原"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource CaptionButton}"><Setter Property="ToolTip" Value="最大化"/><Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="ToolTip" Value="还原"/></DataTrigger></Style.Triggers></Style></Button.Style><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="12" Height="12"><Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M 1,1 L 11,1 11,11 1,11 Z"/><Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Data" Value="M 3,1 L 11,1 11,9 M 1,3 L 9,3 9,11 1,11 Z"/></DataTrigger></Style.Triggers></Style></Path.Style></Path></Button>
    <Button Style="{StaticResource CaptionButton}" Tag="Close" Click="CloseWindow" ToolTip="退出 DriverX" AutomationProperties.Name="退出 DriverX"><Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Width="12" Height="12"/></Button>
   </StackPanel>
  </Grid>
  <Border Grid.Row="1" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal" Margin="12,15"><Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource Accent}"><TextBlock Text="D" Foreground="{DynamicResource OnAccent}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,2,0,0"><TextBlock Text="DriverX" FontSize="{DynamicResource SubtitleSize}" FontWeight="Bold"/><TextBlock Text="远程文件，近在眼前" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource CaptionSize}"/></StackPanel></StackPanel>
   <StackPanel Grid.Row="1"><Button x:Name="DrivesNav" Style="{StaticResource NavButton}" Background="{DynamicResource AccentSoft}" Foreground="{DynamicResource Accent}" Click="ShowDrives">▣   我的磁盘</Button><Button x:Name="ProtocolsNav" Style="{StaticResource NavButton}" Click="ShowProtocols">◈   协议中心</Button><TextBlock x:Name="ManageLabel" Text="管理" Margin="20,26,0,8" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource CaptionSize}"/><Button x:Name="ActivityNav" Style="{StaticResource NavButton}" Click="ShowActivity">⌁   活动与状态</Button></StackPanel>
   <StackPanel Grid.Row="2"><Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Click="ShowSettings">⚙   设置</Button><TextBlock Text="DriverX · Fluent Edition" Margin="18,8" FontSize="{DynamicResource CaptionSize}" Foreground="{DynamicResource TextSecondary}"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Row="1" Grid.Column="1" Margin="42,30,42,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><StackPanel><TextBlock FontFamily="{DynamicResource HeadingFont}" x:Name="PageTitle" Text="我的磁盘" FontSize="{DynamicResource TitleSize}" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="连接远程存储，像本地磁盘一样使用。" Margin="0,7,0,0" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource BodySize}"/></StackPanel><Button x:Name="AddButton" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}" Click="AddConnection">＋ 添加连接</Button></Grid>
   <Grid Grid.Row="1" Margin="0,28,0,0">
    <ScrollViewer x:Name="DrivesPage" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="ConnectionList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
     <Border Width="420" Margin="0,0,18,18" Padding="20" CornerRadius="8" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top"><TextBlock Text="{Binding DriveLabel}" Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="{DynamicResource CardTitleSize}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="{DynamicResource CardTitleSize}" FontWeight="SemiBold"/><TextBlock Text="{Binding Endpoint}" FontSize="{DynamicResource CaptionSize}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{Binding Path}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource CaptionSize}" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/></StackPanel>
      <Border Grid.Column="2" CornerRadius="10" Background="{DynamicResource AccentSoft}" Padding="10,5" VerticalAlignment="Top"><TextBlock Text="{Binding ProtocolLabel}" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource CaptionSize}" FontWeight="SemiBold"/></Border>
      <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,18,0,0"><StackPanel Orientation="Horizontal"><Button Tag="{Binding}" Click="ToggleMount" Style="{StaticResource PrimaryButton}" Content="{Binding ActionLabel}"/><Button Tag="{Binding}" Click="OpenDrive" Margin="9,0,0,0" BorderThickness="1">打开</Button></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Tag="{Binding}" Click="EditConnection" Padding="10,8">编辑</Button><Button Tag="{Binding}" Click="DeleteConnection" Padding="10,8" Margin="4,0,0,0" Foreground="{DynamicResource Danger}">删除</Button></StackPanel></Grid>
     </Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    <StackPanel x:Name="ProtocolsPage" Visibility="Collapsed"><TextBlock Text="可用协议" FontSize="{DynamicResource SubtitleSize}" FontWeight="SemiBold"/><WrapPanel x:Name="ProtocolCards" Margin="0,18,0,0"/></StackPanel>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="0,0,16,24">
      <TextBlock x:Name="AppearanceHeading" Text="外观与排版" FontSize="{DynamicResource SubtitleSize}" FontWeight="SemiBold"/>
      <TextBlock x:Name="AppearanceHint" Text="主题和文字独立设置，切换后立即生效。" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,20"/>
      <Border Style="{StaticResource SettingsCard}"><StackPanel>
       <TextBlock x:Name="LanguageLabel" Text="界面语言" FontWeight="SemiBold"/>
       <TextBlock x:Name="LanguageHint" Text="选择 DriverX 的显示语言。" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,12"/>
       <ComboBox x:Name="LanguageChoice" SelectionChanged="ChooseLanguage" SelectedValuePath="Tag" SelectedIndex="0"><ComboBoxItem Content="中文（简体）" Tag="zh-CN"/><ComboBoxItem Content="日本語" Tag="ja-JP"/><ComboBoxItem Content="English" Tag="en-US"/><ComboBoxItem Content="Français" Tag="fr-FR"/></ComboBox>
      </StackPanel></Border>
      <Border Style="{StaticResource SettingsCard}"><StackPanel>
       <TextBlock Text="应用主题" FontWeight="SemiBold"/>
       <UniformGrid Columns="2" Margin="0,14,0,0">
        <RadioButton x:Name="LightChoice" Style="{StaticResource ThemeChoice}" Tag="light" Click="ChooseTheme"><StackPanel><Border Height="40" Background="#F3F3F3" CornerRadius="4" Margin="0,0,0,10"><Border Background="White" BorderBrush="#D0D0D0" BorderThickness="1" Margin="12,9" CornerRadius="3"/></Border><TextBlock Text="Windows 11 浅色"/><TextBlock Text="明亮 · 轻盈" Style="{StaticResource CaptionText}"/></StackPanel></RadioButton>
        <RadioButton x:Name="DarkChoice" Style="{StaticResource ThemeChoice}" Tag="dark" Click="ChooseTheme"><StackPanel><Border Height="40" Background="#202020" CornerRadius="4" Margin="0,0,0,10"><Border Background="#2D2D2D" BorderBrush="#454545" BorderThickness="1" Margin="12,9" CornerRadius="3"/></Border><TextBlock Text="Windows 11 深色"/><TextBlock Text="炭灰 · 柔和分层" Style="{StaticResource CaptionText}"/></StackPanel></RadioButton>
        <RadioButton x:Name="ContrastChoice" Style="{StaticResource ThemeChoice}" Tag="github-contrast" Click="ChooseTheme"><StackPanel><Border Height="40" Background="#010409" CornerRadius="4" Margin="0,0,0,10"><Border Background="#0D1117" BorderBrush="#71B7FF" BorderThickness="1" Margin="12,9" CornerRadius="3"/></Border><TextBlock Text="GitHub 高对比度"/><TextBlock Text="深黑 · 清晰边界" Style="{StaticResource CaptionText}"/></StackPanel></RadioButton>
        <RadioButton x:Name="SystemChoice" Style="{StaticResource ThemeChoice}" Tag="system" Click="ChooseTheme"><StackPanel><Border Height="40" Background="#E7E7E7" CornerRadius="4" Margin="0,0,0,10"><Border Background="#202020" Width="60" HorizontalAlignment="Right" CornerRadius="0,4,4,0"/></Border><TextBlock Text="跟随系统"/><TextBlock Text="自动切换浅色与深色" Style="{StaticResource CaptionText}"/></StackPanel></RadioButton>
       </UniformGrid>
      </StackPanel></Border>
      <Border Style="{StaticResource SettingsCard}"><StackPanel>
       <TextBlock Text="字体方案" FontWeight="SemiBold"/>
       <TextBlock Text="为中英文分别匹配字体，路径使用等宽字体。" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,12" TextWrapping="Wrap"/>
       <WrapPanel><RadioButton x:Name="FluentFontChoice" Style="{StaticResource OptionChoice}" Tag="fluent" GroupName="Fonts" Click="ChooseFont" Content="Fluent / 微软雅黑"/><RadioButton x:Name="ClassicFontChoice" Style="{StaticResource OptionChoice}" Tag="classic" GroupName="Fonts" Click="ChooseFont" Content="经典 / 微软雅黑"/></WrapPanel>
       <TextBlock Text="文字大小" FontWeight="SemiBold" Margin="0,18,0,10"/>
       <WrapPanel><RadioButton x:Name="StandardSizeChoice" Style="{StaticResource OptionChoice}" Tag="14" GroupName="TextSize" Click="ChooseTextSize" Content="标准 · 14"/><RadioButton x:Name="LargeSizeChoice" Style="{StaticResource OptionChoice}" Tag="16" GroupName="TextSize" Click="ChooseTextSize" Content="舒适 · 16"/></WrapPanel>
       <Border Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,18,0,0"><StackPanel>
        <TextBlock Text="远程工作空间" FontFamily="{DynamicResource HeadingFont}" FontSize="{DynamicResource TitleSize}" FontWeight="SemiBold"/>
        <TextBlock Text="DriverX · 清晰呈现每一个文件" Margin="0,10,0,4"/>
        <TextBlock Text="正文、辅助信息和路径，保持各自的阅读层级。" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
        <TextBlock Text="T:\Projects / research_data_2026.csv" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource CaptionSize}" Foreground="{DynamicResource Accent}" Margin="0,12,0,0"/>
       </StackPanel></Border>
      </StackPanel></Border>
      <Border Style="{StaticResource SettingsCard}"><StackPanel><TextBlock Text="静默挂载" FontWeight="SemiBold"/><TextBlock Text="rclone 在后台运行，不显示命令行窗口。" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"/></StackPanel></Border>
     </StackPanel>
    </ScrollViewer>
    <StackPanel x:Name="InfoPage" Visibility="Collapsed"><TextBlock x:Name="InfoText" FontSize="16" TextWrapping="Wrap"/></StackPanel>
   </Grid>
   <Border Grid.Row="2" Padding="0,14,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"><Grid><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#20B26B"/><TextBlock x:Name="StatusText" Margin="9,0,0,0" Foreground="{DynamicResource TextSecondary}"/></StackPanel><TextBlock x:Name="CountText" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondary}"/></Grid></Border>
  </Grid>
 </Grid>
</Window>
