<Window x:Class="DriverX.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DriverX" Width="1240" Height="780" MinWidth="980" MinHeight="640" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource AppBackground}" FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{DynamicResource TextPrimary}" SourceInitialized="WindowSourceInitialized" Closing="WindowClosing">
 <WindowChrome.WindowChrome>
  <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False"/>
 </WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="CaptionButton" TargetType="Button">
   <Setter Property="Width" Value="38"/><Setter Property="Height" Value="32"/>
   <Setter Property="Margin" Value="2,0"/><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" CornerRadius="8" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.6"/></Trigger>
     <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="Close"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Surface" Property="Background" Value="#E5484D"/><Setter Property="Foreground" Value="White"/></MultiTrigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <SolidColorBrush x:Key="AppBackground" Color="#F6F7FB"/><SolidColorBrush x:Key="SidebarBackground" Color="#FBFCFE"/><SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/><SolidColorBrush x:Key="TextPrimary" Color="#172033"/><SolidColorBrush x:Key="TextSecondary" Color="#687386"/><SolidColorBrush x:Key="BorderBrush" Color="#E3E7EF"/><SolidColorBrush x:Key="Accent" Color="#1683F8"/><SolidColorBrush x:Key="AccentSoft" Color="#E7F2FF"/>
  <Style TargetType="Button"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="16,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value=".75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="10,3"/></Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="242"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Row="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
   <StackPanel Orientation="Horizontal" Margin="26,0" VerticalAlignment="Center"><TextBlock Text="DRIVER" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text=" X" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Accent}"/></StackPanel>
  </Border>
  <Grid Grid.Column="1" Margin="30,0,12,0">
   <TextBlock Text="远程工作空间" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <Button Style="{StaticResource CaptionButton}" Click="ShowSettings" ToolTip="设置" AutomationProperties.Name="设置"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="14"/></Button>
    <Border Width="1" Height="16" Background="{DynamicResource BorderBrush}" Margin="10,0"/>
    <Button Style="{StaticResource CaptionButton}" Click="MinimizeWindow" ToolTip="最小化" AutomationProperties.Name="最小化"><Path Data="M 0,5 L 10,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="10" Height="10"/></Button>
    <Button Click="MaximizeWindow" AutomationProperties.Name="最大化或还原"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource CaptionButton}"><Setter Property="ToolTip" Value="最大化"/><Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="ToolTip" Value="还原"/></DataTrigger></Style.Triggers></Style></Button.Style><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="12" Height="12"><Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M 1,1 L 11,1 11,11 1,11 Z"/><Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Data" Value="M 3,1 L 11,1 11,9 M 1,3 L 9,3 9,11 1,11 Z"/></DataTrigger></Style.Triggers></Style></Path.Style></Path></Button>
    <Button Style="{StaticResource CaptionButton}" Tag="Close" Click="CloseWindow" ToolTip="退出 DriverX" AutomationProperties.Name="退出 DriverX"><Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Width="12" Height="12"/></Button>
   </StackPanel>
  </Grid>
  <Border Grid.Row="1" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal" Margin="12,15"><Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource Accent}"><TextBlock Text="D" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,2,0,0"><TextBlock Text="DriverX" FontSize="20" FontWeight="Bold"/><TextBlock Text="Remote drives, simplified" Foreground="{DynamicResource TextSecondary}" FontSize="11"/></StackPanel></StackPanel>
   <StackPanel Grid.Row="1"><Button Style="{StaticResource NavButton}" Background="{DynamicResource AccentSoft}" Foreground="{DynamicResource Accent}" Click="ShowDrives">▣   我的磁盘</Button><Button Style="{StaticResource NavButton}" Click="ShowProtocols">◈   协议中心</Button><TextBlock Text="管理" Margin="20,26,0,8" Foreground="{DynamicResource TextSecondary}" FontSize="12"/><Button Style="{StaticResource NavButton}" Click="ShowActivity">⌁   活动与状态</Button></StackPanel>
   <StackPanel Grid.Row="2"><Button Style="{StaticResource NavButton}" Click="ShowSettings">⚙   设置</Button><TextBlock Text="DriverX · Fluent Edition" Margin="18,8" FontSize="10" Foreground="{DynamicResource TextSecondary}"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Row="1" Grid.Column="1" Margin="42,30,42,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><StackPanel><TextBlock x:Name="PageTitle" Text="我的磁盘" FontSize="30" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" Text="连接远程存储，像本地磁盘一样使用。" Margin="0,7,0,0" Foreground="{DynamicResource TextSecondary}" FontSize="14"/></StackPanel><Button x:Name="AddButton" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}" Click="AddConnection">＋ 添加连接</Button></Grid>
   <Grid Grid.Row="1" Margin="0,28,0,0">
    <ScrollViewer x:Name="DrivesPage" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="ConnectionList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
     <Border Width="420" Margin="0,0,18,18" Padding="20" CornerRadius="14" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top"><TextBlock Text="{Binding DriveLabel}" Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding Endpoint}" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{Binding Path}" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/></StackPanel>
      <Border Grid.Column="2" CornerRadius="10" Background="{DynamicResource AccentSoft}" Padding="10,5" VerticalAlignment="Top"><TextBlock Text="{Binding ProtocolLabel}" Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="SemiBold"/></Border>
      <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,18,0,0"><StackPanel Orientation="Horizontal"><Button Tag="{Binding}" Click="ToggleMount" Style="{StaticResource PrimaryButton}" Content="{Binding ActionLabel}"/><Button Tag="{Binding}" Click="OpenDrive" Margin="9,0,0,0" BorderThickness="1">打开</Button></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Tag="{Binding}" Click="EditConnection" Padding="10,8">编辑</Button><Button Tag="{Binding}" Click="DeleteConnection" Padding="10,8" Margin="4,0,0,0" Foreground="#E04F5F">删除</Button></StackPanel></Grid>
     </Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    <StackPanel x:Name="ProtocolsPage" Visibility="Collapsed"><TextBlock Text="可用协议" FontSize="20" FontWeight="SemiBold"/><WrapPanel x:Name="ProtocolCards" Margin="0,18,0,0"/></StackPanel>
    <StackPanel x:Name="SettingsPage" Visibility="Collapsed" MaxWidth="720" HorizontalAlignment="Left"><TextBlock Text="外观" FontSize="20" FontWeight="SemiBold"/><Border Margin="0,16,0,24" Padding="20" CornerRadius="14" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><StackPanel><TextBlock Text="应用主题" FontWeight="SemiBold"/><TextBlock Text="选择适合系统环境的界面模式。" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,14"/><StackPanel Orientation="Horizontal"><Button Click="UseLightTheme">浅色</Button><Button Click="UseDarkTheme" Margin="9,0,0,0">深色</Button><Button Click="UseSystemTheme" Margin="9,0,0,0">跟随系统</Button></StackPanel></StackPanel></Border><TextBlock Text="运行" FontSize="20" FontWeight="SemiBold"/><Border Margin="0,16,0,0" Padding="20" CornerRadius="14" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><StackPanel><TextBlock Text="静默挂载" FontWeight="SemiBold"/><TextBlock Text="rclone 在后台运行，不显示命令行窗口。" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,0"/></StackPanel></Border></StackPanel>
    <StackPanel x:Name="InfoPage" Visibility="Collapsed"><TextBlock x:Name="InfoText" FontSize="16" TextWrapping="Wrap"/></StackPanel>
   </Grid>
   <Border Grid.Row="2" Padding="0,14,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"><Grid><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#20B26B"/><TextBlock x:Name="StatusText" Margin="9,0,0,0" Foreground="{DynamicResource TextSecondary}"/></StackPanel><TextBlock x:Name="CountText" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondary}"/></Grid></Border>
  </Grid>
 </Grid>
</Window>
