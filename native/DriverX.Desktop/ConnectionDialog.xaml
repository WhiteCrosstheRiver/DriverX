<Window x:Class="DriverX.Desktop.ConnectionDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="连接设置" Width="570" Height="735" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F6F7FB" FontFamily="Segoe UI Variable Text, Segoe UI"><Window.Resources><Style TargetType="TextBox"><Setter Property="Height" Value="36"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Padding" Value="9,0"/></Style><Style TargetType="ComboBox"><Setter Property="Height" Value="36"/><Setter Property="Margin" Value="0,0,0,12"/></Style><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style></Window.Resources>
 <Grid Margin="34"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="添加远程存储" FontSize="26" FontWeight="Bold"/><TextBlock Text="选择协议并填写连接信息" Foreground="#687386" Margin="0,6,0,24"/></StackPanel>
 <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
 <TextBlock Text="协议"/><ComboBox x:Name="Protocol" Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="sftp"/><ComboBoxItem Content="webdav"/><ComboBoxItem Content="ftp"/><ComboBoxItem Content="smb"/><ComboBoxItem Content="s3"/><ComboBoxItem Content="onedrive"/><ComboBoxItem Content="drive"/><ComboBoxItem Content="dropbox"/></ComboBox><TextBlock Grid.Row="1" Text="名称"/><TextBox x:Name="ProfileName" Grid.Row="1" Grid.Column="1"/><TextBlock Grid.Row="2" Text="主机 / URL"/><TextBox x:Name="Host" Grid.Row="2" Grid.Column="1"/><TextBlock Grid.Row="3" Text="端口"/><TextBox x:Name="Port" Text="22" Grid.Row="3" Grid.Column="1"/><TextBlock Grid.Row="4" Text="用户名"/><TextBox x:Name="User" Grid.Row="4" Grid.Column="1"/><TextBlock Grid.Row="5" Text="密码"/><PasswordBox x:Name="Password" Grid.Row="5" Grid.Column="1"/><TextBlock Grid.Row="6" Text="SSH 私钥"/><TextBox x:Name="Keyfile" Grid.Row="6" Grid.Column="1" ToolTip="例如 %USERPROFILE%\.ssh\id_ed25519"/><TextBlock Grid.Row="7" Text="远程目录"/><TextBox x:Name="RemotePath" Text="/" Grid.Row="7" Grid.Column="1"/><TextBlock Grid.Row="8" Text="本地盘符"/><TextBox x:Name="Drive" Text="Z" MaxLength="1" Grid.Row="8" Grid.Column="1"/></Grid>
 <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Padding="18,9" Margin="0,0,10,0" Click="Cancel"/><Button Content="保存连接" Padding="18,9" Background="#1683F8" Foreground="White" BorderThickness="0" Click="Save"/></StackPanel></Grid>
</Window>
