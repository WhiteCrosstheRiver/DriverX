<Window x:Class="DriverX.Desktop.ConnectionDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="连接设置" Width="570" SizeToContent="Height" MaxHeight="760" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}" FontFamily="{DynamicResource BodyFont}" FontSize="{DynamicResource BodySize}" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
 <Grid Background="{DynamicResource AppBackground}" Margin="34"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="添加远程存储" FontSize="{DynamicResource TitleSize}" FontWeight="SemiBold"/><TextBlock x:Name="DialogSubtitle" Text="先选协议，只填写它需要的信息。" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,24"/></StackPanel>
 <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="协议 *"/><ComboBox x:Name="Protocol" Grid.Column="1" SelectedIndex="0" SelectionChanged="ProtocolChanged"><ComboBoxItem Content="SFTP" Tag="sftp"/><ComboBoxItem Content="WebDAV" Tag="webdav"/><ComboBoxItem Content="FTP" Tag="ftp"/><ComboBoxItem Content="SMB" Tag="smb"/><ComboBoxItem Content="S3" Tag="s3"/><ComboBoxItem Content="OneDrive" Tag="onedrive"/><ComboBoxItem Content="Google Drive" Tag="drive"/><ComboBoxItem Content="Dropbox" Tag="dropbox"/></ComboBox>
  <TextBlock Grid.Row="1" Text="名称 *"/><TextBox x:Name="ProfileName" Grid.Row="1" Grid.Column="1" ToolTip="显示在 DriverX 首页的名称"/>
  <TextBlock x:Name="HostLabel" Grid.Row="2" Text="主机 *"/><TextBox x:Name="Host" Grid.Row="2" Grid.Column="1"/>
  <TextBlock x:Name="PortLabel" Grid.Row="3" Text="端口"/><TextBox x:Name="Port" Text="22" Grid.Row="3" Grid.Column="1"/>
  <TextBlock x:Name="UserLabel" Grid.Row="4" Text="用户名"/><TextBox x:Name="User" Grid.Row="4" Grid.Column="1"/>
  <TextBlock x:Name="PasswordLabel" Grid.Row="5" Text="密码（可选）"/><PasswordBox x:Name="Password" Grid.Row="5" Grid.Column="1"/>
  <TextBlock x:Name="KeyfileLabel" Grid.Row="6" Text="SSH 私钥（可选）"/><TextBox x:Name="Keyfile" Grid.Row="6" Grid.Column="1" ToolTip="例如 %USERPROFILE%\.ssh\id_ed25519"/>
  <TextBlock x:Name="PathLabel" Grid.Row="7" Text="远程目录"/><TextBox x:Name="RemotePath" Text="/" Grid.Row="7" Grid.Column="1"/>
  <TextBlock Grid.Row="8" Text="本地盘符 *"/><TextBox x:Name="Drive" Text="Z" MaxLength="1" Grid.Row="8" Grid.Column="1" ToolTip="输入一个未使用的英文字母"/>
 </Grid>
 <Grid Grid.Row="2" Margin="0,18,0,0"><TextBlock x:Name="ProtocolHint" Foreground="{DynamicResource TextSecondary}" Text="密码和私钥任选其一即可。" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Padding="18,9" Margin="0,0,10,0" Click="Cancel"/><Button Content="保存连接" Padding="18,9" Style="{StaticResource PrimaryButton}" Click="Save"/></StackPanel></Grid></Grid>
</Window>
